<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.QuestionMapper">

    <resultMap id="QuestionResult" type="com.ruoyi.system.domain.Question">
        <id     property="questionId"   column="question_id"/>
        <result property="bankId"       column="bank_id"/>
        <result property="questionType" column="question_type"/>
        <result property="stem"         column="stem"/>
        <result property="options"      column="options"/>
        <result property="answer"       column="answer"/>
        <result property="score"        column="score"/>
        <result property="difficulty"   column="difficulty"/>
        <result property="bankName"     column="bank_name"/>
        <result property="createBy"     column="create_by"/>
        <result property="createTime"   column="create_time"/>
        <result property="updateBy"     column="update_by"/>
        <result property="updateTime"   column="update_time"/>
        <result property="remark"       column="remark"/>
    </resultMap>

    <sql id="selectQuestionVo">
        select q.question_id, q.bank_id, q.question_type, q.stem, q.options, q.answer, q.score, q.difficulty,
               b.bank_name, q.create_by, q.create_time, q.update_by, q.update_time, q.remark
        from question q
        left join question_bank b on q.bank_id = b.bank_id
    </sql>

    <select id="selectQuestionList" parameterType="com.ruoyi.system.domain.Question" resultMap="QuestionResult">
        <include refid="selectQuestionVo"/>
        <where>
            <if test="bankId != null"> and q.bank_id = #{bankId}</if>
            <if test="questionType != null and questionType != ''"> and q.question_type = #{questionType}</if>
            <if test="stem != null and stem != ''"> and q.stem like concat('%', #{stem}, '%')</if>
        </where>
        order by q.question_id desc
    </select>

    <select id="selectQuestionById" parameterType="Long" resultMap="QuestionResult">
        <include refid="selectQuestionVo"/>
        where q.question_id = #{questionId}
    </select>

    <insert id="insertQuestion" parameterType="com.ruoyi.system.domain.Question" useGeneratedKeys="true" keyProperty="questionId">
        insert into question
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="bankId != null">bank_id,</if>
            <if test="questionType != null and questionType != ''">question_type,</if>
            <if test="stem != null">stem,</if>
            <if test="options != null">options,</if>
            <if test="answer != null">answer,</if>
            <if test="score != null">score,</if>
            <if test="difficulty != null and difficulty != ''">difficulty,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="bankId != null">#{bankId},</if>
            <if test="questionType != null and questionType != ''">#{questionType},</if>
            <if test="stem != null">#{stem},</if>
            <if test="options != null">#{options},</if>
            <if test="answer != null">#{answer},</if>
            <if test="score != null">#{score},</if>
            <if test="difficulty != null and difficulty != ''">#{difficulty},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateQuestion" parameterType="com.ruoyi.system.domain.Question">
        update question
        <trim prefix="SET" suffixOverrides=",">
            <if test="bankId != null">bank_id = #{bankId},</if>
            <if test="questionType != null and questionType != ''">question_type = #{questionType},</if>
            <if test="stem != null">stem = #{stem},</if>
            <if test="options != null">options = #{options},</if>
            <if test="answer != null">answer = #{answer},</if>
            <if test="score != null">score = #{score},</if>
            <if test="difficulty != null and difficulty != ''">difficulty = #{difficulty},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where question_id = #{questionId}
    </update>

    <delete id="deleteQuestionById" parameterType="Long">
        delete from question where question_id = #{questionId}
    </delete>

    <delete id="deleteQuestionByIds" parameterType="Long">
        delete from question where question_id in
        <foreach collection="array" item="questionId" open="(" separator="," close=")">
            #{questionId}
        </foreach>
    </delete>

    <select id="countPaperRefById" parameterType="Long" resultType="int">
        select count(1) from paper_question where question_id = #{questionId}
    </select>

    <select id="selectRandomQuestionList" resultMap="QuestionResult">
        select q.question_id, q.bank_id, q.question_type, q.stem, q.options, q.answer, q.score, q.difficulty
        from question q
        where q.bank_id = #{bankId} and q.question_type = #{questionType}
        order by rand()
        limit #{limit}
    </select>
</mapper>
